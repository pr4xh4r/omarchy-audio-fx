#!/usr/bin/env python3
"""
audiofx-smart — Device detection + preset auto-merging for omarchy-audio-fx

Detects the active audio output device via PipeWire/PulseAudio and
silently merges the right device compensation into whatever preset
the user picked — so the user never has to think about device profiles.

Usage:
  audiofx-smart detect              → print detected device type
  audiofx-smart merge <preset>      → merge device comp + preset, print name|device
  audiofx-smart info                → print full device info as JSON
"""

import json
import os
import re
import subprocess
import sys

HOME = os.environ.get("HOME", "")
PRESETS_DIR = f"{HOME}/.local/share/easyeffects/output"

# Map detected device type → device preset name
DEVICE_PRESET = {
    "headphones":         "Headphones",
    "iem":                "IEM",
    "earbuds":            "Earbuds",
    "laptop-speakers":    "Laptop-Speakers",
    "desktop-speakers":   "Desktop-Speakers",
    "bluetooth-speaker":  "Bluetooth-Speaker",   # portable/external BT speaker
}

# Which plugins from the device preset to prepend to the signature chain.
# The signature provides EQ character, the device provides the correction layer.
DEVICE_PREPEND_PLUGINS = {
    "headphones":         ["crossfeed#0"],                       # removes in-head feeling
    "iem":                [],                                     # IEM EQ handled in sig
    "earbuds":            ["bass_enhancer#0"],                   # psychoacoustic bass
    "laptop-speakers":    ["bass_enhancer#0", "stereo_tools#0"], # bass + widen
    "desktop-speakers":   [],                                     # reference, no correction
    "bluetooth-speaker":  ["equalizer#0", "bass_enhancer#0"],   # SBC treble restore + bass
}


def run(cmd):
    try:
        return subprocess.check_output(cmd, text=True, stderr=subprocess.DEVNULL)
    except Exception:
        return ""


def detect_device():
    """
    Figures out what audio device is active using PipeWire/pactl.
    Only looks at the ACTIVE sink section — avoids false matches
    from port labels in other sinks.
    Returns one of: headphones, iem, earbuds, laptop-speakers, desktop-speakers
    """
    sink_name = run(["pactl", "get-default-sink"]).strip()

    # ── Isolate ONLY the active sink's section ───────────────────────────────
    all_sinks = run(["pactl", "list", "sinks"])
    active_section = ""
    for block in all_sinks.split("\n\n"):
        if sink_name in block:
            active_section = block
            break

    # Also grab the matching card block
    all_cards = run(["pactl", "list", "cards"])
    active_card = ""
    card_id = sink_name.replace("bluez_output.", "bluez_card.").rsplit(".", 1)[0]
    card_id = card_id.replace("alsa_output.", "alsa_card.")
    for block in all_cards.split("\n\n"):
        if card_id in block or sink_name.split(".")[0] in block:
            active_card = block
            break

    # Search blob = active sink + active card ONLY (not all sinks)
    blob = (sink_name + " " + active_section + " " + active_card).lower()

    # ── Bluetooth device ─────────────────────────────────────────────────────
    if re.search(r"bluez|bluetooth|a2dp|hsp|hfp", blob):

        # ── Product name FIRST (more reliable than BT class code) ────────────
        # Many BT speakers misreport their class in firmware (e.g. Stone 1500
        # reports minor=0x01/Headset but is clearly a speaker).
        # Speaker brand/model keywords → bluetooth-speaker (not desktop-speakers)
        if re.search(
            r"\bspeaker\b|soundbar|sound.bar|boombox|boom.box|stone\b|flip\b"
            r"|charge\b|pulse\b|xtreme\b|wonderboom|roam\b|revolve\b"
            r"|portable.*speaker|home.*audio|jbl\s*(go|clip|bar)|ue\s*(boom|roll)"
            r"|anker\s*sound|tribit|marshall\s*(acton|stanmore|woburn|emberton|tufton)"
            r"|bose\s*(soundlink|home|smart\s*speaker)|sonos|harman\s*kardon"
            r"|ultimate\s*ears|creative\s*(pebble|t\d)|edifier|klipsch"
            r"|\bboat\b|aavante|partypal|stone\s*\d+|blaster",
            blob
        ):
            return "bluetooth-speaker"

        # Earbud / TWS keywords
        if re.search(
            r"earbud|earphone|tws|in.ear|bean|sport|liberty|freebuds|free.buds"
            r"|galaxy.buds|echo.buds|pixel.buds|\bdots\b|nothing.*ear|oppo.*enco"
            r"|jabra.*elite|soundcore.*life|anker.*soundcore.*p[0-9]",
            blob
        ):
            return "earbuds"

        # Headphone keywords
        if re.search(
            r"\bheadphone\b|over.ear|on.ear|wh-\d|qc\s*\d+|hd\s*\d|studio.*wireless"
            r"|live.*\d|tune\s*\d|ath-m|dt\s*\d{3}|mdr-|momentum|anc.*head|bose.*qc"
            r"|sony.*wh|jbl.*live|jabra.*evolve",
            blob
        ):
            return "headphones"

        # ── BT class code as fallback (when name gives no clues) ─────────────
        # BT class: bits [12:8] = major, bits [7:2] = minor (Major 0x04 = Audio)
        # Minor: 0x01=Headset, 0x05=Loudspeaker, 0x06=Headphones, 0x07=Portable
        bt_class_match = re.search(
            r"api\.bluez5\.class\s*=\s*\"(0x[0-9a-fA-F]+)\"",
            active_section + active_card
        )
        if bt_class_match:
            bt_class = int(bt_class_match.group(1), 16)
            minor = (bt_class >> 2) & 0x3F
            major = (bt_class >> 8) & 0x1F
            if major == 0x04:
                if minor in (0x05, 0x07, 0x08):   # Loudspeaker, Portable, Car
                    return "desktop-speakers"
                elif minor in (0x06,):             # Headphones (not 0x01 — too misused)
                    return "headphones"
                elif minor == 0x03:
                    return "earbuds"

        # Earbud / TWS keywords
        if re.search(
            r"earbud|earphone|tws|in.ear|bean|sport|liberty|freebuds|free.buds"
            r"|galaxy.buds|echo.buds|pixel.buds|dots\b",
            blob
        ):
            return "earbuds"

        # Headphone keywords
        if re.search(
            r"headphone|over.ear|on.ear|wh-\d|qc\d|hd\s*\d|studio.*wireless"
            r"|live.*\d|tune\s*\d",
            blob
        ):
            return "headphones"

        # Last resort: form_factor field
        ff = re.search(r"device\.form_factor\s*=\s*\"(\w+)\"", active_section + active_card)
        if ff:
            if ff.group(1).lower() in ("speaker", "tv", "portable"):
                return "desktop-speakers"
            if ff.group(1).lower() == "headphone":
                return "headphones"

        return "earbuds"  # safest BT fallback

    # ── Wired headphones / headset ──────────────────────────────────────────
    if re.search(r"headphone|headset", blob):
        if re.search(r"shure|etymotic|campfire|westone|64.audio|noble|iem|in.ear.monitor|custom.iem", blob):
            return "iem"
        return "headphones"

    # ── HDMI / DisplayPort ──────────────────────────────────────────────────
    if re.search(r"hdmi|displayport|\bdp\b|monitor.*audio|tv\b|receiver", blob):
        return "desktop-speakers"

    # ── Internal / built-in (check if laptop or desktop) ───────────────────
    has_battery = any(
        os.path.exists(f"/sys/class/power_supply/{b}/status")
        for b in ["BAT0", "BAT1", "BAT", "battery"]
    )

    if re.search(r"built.in|builtin|internal|analog.stereo|snd_hda|analog.*output", blob):
        return "laptop-speakers" if has_battery else "desktop-speakers"

    # ── Fallback: use battery presence to guess ─────────────────────────────
    return "laptop-speakers" if has_battery else "desktop-speakers"


def load_preset(name):
    path = f"{PRESETS_DIR}/{name}.json"
    if not os.path.exists(path):
        return None
    with open(path) as f:
        return json.load(f)


def merge_preset(signature_name, device_type):
    """
    Merges device compensation plugins with the user's chosen signature.

    Strategy:
      - Device provides pre-processing (crossfeed, bass_enhancer, stereo_tools)
      - Signature provides EQ character + compressor + maximizer
      - Device plugins go first in the chain, signature follows

    Returns the name of the merged preset (written to PRESETS_DIR).
    """
    sig_data = load_preset(signature_name)
    if not sig_data:
        return signature_name, device_type  # fallback: use as-is

    sig_out = sig_data["output"]
    prepend = DEVICE_PREPEND_PLUGINS.get(device_type, [])

    # No device compensation needed for this device type
    if not prepend:
        return signature_name, device_type

    device_preset_name = DEVICE_PRESET.get(device_type)
    dev_data = load_preset(device_preset_name)

    if not dev_data:
        return signature_name, device_type  # device preset missing, use sig as-is

    dev_out = dev_data["output"]

    # Build merged plugin order: device prepend → signature chain (dedup)
    sig_plugins = sig_out.get("plugins_order", [])
    merged_order = prepend + [p for p in sig_plugins if p not in prepend]

    merged = {
        "output": {
            "blocklist": [],
            "plugins_order": merged_order
        }
    }

    # Pull device-specific plugin configs
    for plugin in prepend:
        if plugin in dev_out:
            merged["output"][plugin] = dev_out[plugin]

    # Pull signature plugin configs (signature EQ/compressor/maximizer)
    for plugin in sig_plugins:
        merged["output"][plugin] = sig_out[plugin]

    # Write merged preset to a temp file in the EasyEffects dir
    merged_name = f"_smart_{signature_name}"
    merged_path = f"{PRESETS_DIR}/{merged_name}.json"
    with open(merged_path, "w") as f:
        json.dump(merged, f, indent=4)

    return merged_name, device_type


def device_label(device_type):
    labels = {
        "headphones":        "Headphones (crossfeed on)",
        "iem":               "IEM (resonance-corrected)",
        "earbuds":           "Earbuds (bass-virtualized)",
        "laptop-speakers":   "Laptop Speakers (widened + bass-boosted)",
        "desktop-speakers":  "Desktop Speakers (reference)",
        "bluetooth-speaker": "Bluetooth Speaker (SBC-compensated)",
    }
    return labels.get(device_type, device_type)


OVERRIDE_FILE = f"{HOME}/.config/audiofx/device-override"
VALID_TYPES   = ["headphones", "iem", "earbuds", "laptop-speakers", "desktop-speakers", "bluetooth-speaker"]


def get_override():
    """Return manually set device type, or None if not set."""
    try:
        val = open(OVERRIDE_FILE).read().strip()
        return val if val in VALID_TYPES else None
    except FileNotFoundError:
        return None


def get_device_name():
    """Extract the human-friendly device name from PipeWire (e.g. 'boAt Stone 1500')."""
    sink_name    = run(["pactl", "get-default-sink"]).strip()
    all_sinks    = run(["pactl", "list", "sinks"])
    active_block = ""
    for block in all_sinks.split("\n\n"):
        if sink_name in block:
            active_block = block
            break

    # Try device.description first, then media.name, then Description: line
    for pattern in [
        r'device\.description\s*=\s*"([^"]+)"',
        r'media\.name\s*=\s*"([^"]+)"',
        r'Description:\s*(.+)',
    ]:
        m = re.search(pattern, active_block)
        if m:
            name = m.group(1).strip()
            if name and name.lower() not in ("easy effects sink", ""):
                return name

    return sink_name  # fallback to raw sink id


def resolve_device():
    """Return (device_type, from_override). Respects manual override if set."""
    override = get_override()
    if override:
        return override, True
    return detect_device(), False


if __name__ == "__main__":
    cmd = sys.argv[1] if len(sys.argv) > 1 else "detect"

    if cmd == "detect":
        device, _ = resolve_device()
        print(device)

    elif cmd == "merge":
        if len(sys.argv) < 3:
            print("Usage: audiofx-smart merge <preset-name>", file=sys.stderr)
            sys.exit(1)
        preset = sys.argv[2]
        device, _ = resolve_device()
        merged_name, dev = merge_preset(preset, device)
        print(f"{merged_name}|{dev}|{device_label(dev)}")

    elif cmd == "info":
        device, from_override = resolve_device()
        sink      = run(["pactl", "get-default-sink"]).strip()
        dev_name  = get_device_name()
        info = {
            "sink":             sink,
            "device_name":      dev_name,
            "detected_device":  device,
            "override":         from_override,
            "label":            device_label(device),
            "compensation":     DEVICE_PREPEND_PLUGINS.get(device, []),
            "device_preset":    DEVICE_PRESET.get(device, "None"),
        }
        print(json.dumps(info, indent=2))

    elif cmd == "set-override":
        if len(sys.argv) < 3 or sys.argv[2] not in VALID_TYPES:
            print(f"Valid types: {', '.join(VALID_TYPES)}", file=sys.stderr)
            sys.exit(1)
        os.makedirs(os.path.dirname(OVERRIDE_FILE), exist_ok=True)
        open(OVERRIDE_FILE, "w").write(sys.argv[2])
        print(sys.argv[2])

    elif cmd == "clear-override":
        try:
            os.remove(OVERRIDE_FILE)
        except FileNotFoundError:
            pass
        print("cleared")

    else:
        print(f"Unknown command: {cmd}", file=sys.stderr)
        sys.exit(1)

