#!/usr/bin/env bash
# audio-mode — cycle audio presets via Super+M
# Part of: omarchy-audio-fx  |  https://github.com/pr4xh4r/omarchy-audio-fx
#
# Device is auto-detected on every press and compensation is merged silently.
# The user only cycles through sound signatures and experience modes.
#
# Full cycle (17 states):
#
#  ─── 🎵 Sound Signatures ─────────────────────────────────────────────
#   0  Off              — No processing (bypass)
#   1  Marshall         — Warm bass · Punchy mids · Guitar-amp feel
#   2  Dolby-Atmos      — Wide · Immersive · Spatial cinema
#   3  Harman           — Research-backed · Most humans prefer this
#   4  Sony-Clear       — Deep bass · Crystal vocals · ANC-inspired
#   5  Bose-Comfort     — Balanced · Warm · Zero listening fatigue
#   6  JBL-Loud         — V-shaped · Energetic · Party-ready
#   7  Sennheiser-Detail— Analytical · Flat · Wide soundstage
#   8  Bass-Beast       — Sub-heavy · Psychoacoustic bass · Club
#   9  Vocal-Clarity    — Speech-forward · Podcast · Remove rumble
#  10  Lo-Fi            — Vintage · Tape warmth · Rolled highs
#  11  Crystal-Air      — Airy · Detailed · Open soundstage
#  12  Night-Mode       — Soft · Compressed · Late-night listening
#
#  ─── 🌍 Experience Modes ─────────────────────────────────────────────
#  13  Cinema           — Wide stage · Dialogue boost · Depth
#  14  Gaming           — Positional cues · 2–8kHz · Fast transients
#  15  Party            — Max bass · Hard limiter · Protected
#  16  Focus            — Flat · Crossfeed · Non-fatiguing

STATE_FILE="$HOME/.local/share/audio-mode-state"
SMART_SCRIPT="$HOME/.local/bin/audiofx-smart"
TOTAL_MODES=17   # 0..16

# ── Ensure EasyEffects runs as a service (survives terminal close) ─────────────
ensure_ee_service() {
    if pgrep -x easyeffects >/dev/null 2>&1; then
        return 0  # already running
    fi

    # Try systemd user service first (survives logout on some setups)
    if systemctl --user start easyeffects 2>/dev/null; then
        sleep 0.8
        return 0
    fi

    # Fallback: launch detached from terminal using setsid + service-mode
    setsid easyeffects --service-mode >/dev/null 2>&1 &
    disown $!
    sleep 1
}

MODE_PRESET=(
  ""                   #  0 — Off
  "Marshall"           #  1
  "Dolby-Atmos"        #  2
  "Harman"             #  3
  "Sony-Clear"         #  4
  "Bose-Comfort"       #  5
  "JBL-Loud"           #  6
  "Sennheiser-Detail"  #  7
  "Bass-Beast"         #  8
  "Vocal-Clarity"      #  9
  "Lo-Fi"              # 10
  "Crystal-Air"        # 11
  "Night-Mode"         # 12
  "Cinema"             # 13
  "Gaming"             # 14
  "Party"              # 15
  "Focus"              # 16
)

MODE_TITLE=(
  "⚫  Audio FX Off"
  "🟠  Marshall"
  "🔵  Dolby Atmos"
  "🟢  Harman"
  "🩵  Sony Clear"
  "🟣  Bose Comfort"
  "🔴  JBL Loud"
  "⬜  Sennheiser Detail"
  "💥  Bass Beast"
  "🎙️  Vocal Clarity"
  "📻  Lo-Fi"
  "💎  Crystal Air"
  "🌙  Night Mode"
  "🎬  Cinema"
  "🎮  Gaming"
  "🎉  Party"
  "📚  Focus"
)

MODE_BODY=(
  "No audio processing — flat output"
  "Warm bass · Punchy mids · Guitar-amp feel"
  "Wide · Immersive · Spatial cinema sound"
  "Research-backed · Most humans prefer this"
  "Deep bass · Crystal vocals · ANC-inspired"
  "Balanced · Warm · Zero listening fatigue"
  "V-shaped · Energetic · Party-ready"
  "Analytical · Flat reference · Wide soundstage"
  "Sub-heavy · Psychoacoustic bass · Club feel"
  "Speech-forward · Podcast · Removes rumble"
  "Vintage · Tape warmth · Rolled highs"
  "Airy · Detailed · Open IEM soundstage"
  "Soft · Compressed dynamics · Late-night"
  "Wide stage · Dialogue boost · Cinematic depth"
  "Positional cues · 2–8kHz detail · Fast"
  "Max bass · Hard limiter · Protected speakers"
  "Flat · Crossfeed · Non-fatiguing · Work mode"
)

# ── Read & advance state ──────────────────────────────────────────────────────
current=$(cat "$STATE_FILE" 2>/dev/null || echo "0")
if ! [[ "$current" =~ ^[0-9]+$ ]] || (( current >= TOTAL_MODES )); then
  current=0
fi

next=$(( (current + 1) % TOTAL_MODES ))
echo "$next" > "$STATE_FILE"

# ── Apply the mode ────────────────────────────────────────────────────────────
preset="${MODE_PRESET[$next]}"

if (( next == 0 )); then
  # Off — bypass all effects (EasyEffects stays running as service)
  ensure_ee_service
  easyeffects --bypass 1 &>/dev/null
  device_label="off"
else
  # Ensure EasyEffects is running as a detached service
  ensure_ee_service

  # Smart apply: detect device + merge compensation silently
  applied_preset="$preset"
  device_label=""

  if [[ -f "$SMART_SCRIPT" ]] && command -v python3 >/dev/null; then
    result=$(python3 "$SMART_SCRIPT" merge "$preset" 2>/dev/null || echo "${preset}|unknown|unknown")
    applied_preset=$(echo "$result" | cut -d'|' -f1)
    device_label=$(echo "$result" | cut -d'|' -f3)
  fi

  easyeffects --bypass 2 &>/dev/null
  sleep 0.3
  easyeffects --load-preset "$applied_preset" &>/dev/null

  # Sync audiofx state file
  AUDIOFX_STATE="$HOME/.config/audiofx/state"
  mkdir -p "$HOME/.config/audiofx"
  cat > "$AUDIOFX_STATE" <<EOF
SIGNATURE=${preset}
DEVICE=${device_label}
MODE=
APPLIED_PRESET=${applied_preset}
TIMESTAMP=$(date -Iseconds)
EOF
fi

# ── Notify ────────────────────────────────────────────────────────────────────
body="${MODE_BODY[$next]}"
# Append device info to notification body if we know it
[[ -n "$device_label" && "$device_label" != "off" && "$device_label" != "unknown" ]] \
  && body="${body}  •  ${device_label}"

notify-send \
  --urgency=low \
  --expire-time=2500 \
  --hint=string:x-canonical-private-synchronous:audio-mode \
  "${MODE_TITLE[$next]}" \
  "$body"
