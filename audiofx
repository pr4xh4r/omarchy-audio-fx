#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────────────────
#  audiofx — Smart audio mode switcher for Linux (EasyEffects + PipeWire)
#  Part of: omarchy-audio-fx  |  https://github.com/pr4xh4r/omarchy-audio-fx
#
#  The user picks a sound signature or experience mode.
#  The system auto-detects the active device and silently merges in
#  the right compensation (crossfeed for headphones, bass for earbuds, etc.)
#  No manual device selection needed.
# ─────────────────────────────────────────────────────────────────────────────

set -euo pipefail

PRESET_DIR="${HOME}/.local/share/easyeffects/output"
STATE_FILE="${HOME}/.config/audiofx/state"
CONFIG_DIR="${HOME}/.config/audiofx"
SMART_SCRIPT="${HOME}/.local/bin/audiofx-smart"
VERSION="2.0.0"

# ── Colors ────────────────────────────────────────────────────────────────────
BOLD="\033[1m"; DIM="\033[2m"; RESET="\033[0m"
RED="\033[1;31m"; GREEN="\033[1;32m"; YELLOW="\033[1;33m"
BLUE="\033[1;34m"; CYAN="\033[1;36m"; PURPLE="\033[1;35m"
ORANGE="\033[38;5;208m"

# ── Signatures ────────────────────────────────────────────────────────────────
SIGNATURES=(
  Marshall Dolby-Atmos Harman Sony-Clear Bose-Comfort
  JBL-Loud Sennheiser-Detail Bass-Beast Vocal-Clarity
  Lo-Fi Crystal-Air Night-Mode
)

declare -A SIG_DESC SIG_COLOR
SIG_DESC["Marshall"]="Warm bass · Punchy mids · Guitar-amp feel"
SIG_DESC["Dolby-Atmos"]="Wide · Immersive · Spatial cinema sound"
SIG_DESC["Harman"]="Research-backed · Most humans prefer this"
SIG_DESC["Sony-Clear"]="Deep bass · Crystal vocals · ANC-inspired"
SIG_DESC["Bose-Comfort"]="Balanced · Warm · Zero listening fatigue"
SIG_DESC["JBL-Loud"]="V-shaped · Energetic · Party-ready"
SIG_DESC["Sennheiser-Detail"]="Analytical · Flat reference · Wide soundstage"
SIG_DESC["Bass-Beast"]="Sub-heavy · Psychoacoustic bass · Club feel"
SIG_DESC["Vocal-Clarity"]="Speech-forward · Podcast · Removes rumble"
SIG_DESC["Lo-Fi"]="Vintage · Tape warmth · Rolled highs"
SIG_DESC["Crystal-Air"]="Airy · Detailed · Open IEM soundstage"
SIG_DESC["Night-Mode"]="Soft · Compressed dynamics · Late-night"

SIG_COLOR["Marshall"]="${ORANGE}"; SIG_COLOR["Dolby-Atmos"]="${BLUE}"
SIG_COLOR["Harman"]="${GREEN}";    SIG_COLOR["Sony-Clear"]="${CYAN}"
SIG_COLOR["Bose-Comfort"]="${PURPLE}"; SIG_COLOR["JBL-Loud"]="${RED}"
SIG_COLOR["Sennheiser-Detail"]="${DIM}"; SIG_COLOR["Bass-Beast"]="${RED}"
SIG_COLOR["Vocal-Clarity"]="${GREEN}";   SIG_COLOR["Lo-Fi"]="${YELLOW}"
SIG_COLOR["Crystal-Air"]="${CYAN}";      SIG_COLOR["Night-Mode"]="${BLUE}"

# ── Experience Modes ──────────────────────────────────────────────────────────
MODES=(Cinema Gaming Party Focus)

declare -A MODE_DESC
MODE_DESC["Cinema"]="Wide stage · Dialogue boost · Cinematic depth"
MODE_DESC["Gaming"]="Positional cues · 2–8kHz detail · Fast transients"
MODE_DESC["Party"]="Max bass · Hard limiter · Protected speakers"
MODE_DESC["Focus"]="Flat · Crossfeed · Non-fatiguing · Work mode"

# ── Helpers ───────────────────────────────────────────────────────────────────
die()  { echo -e "${RED}✗${RESET} $*" >&2; exit 1; }
info() { echo -e "${GREEN}✓${RESET} $*"; }
warn() { echo -e "${YELLOW}⚠${RESET} $*"; }
tip()  { echo -e "${DIM}  → $*${RESET}"; }

preset_exists() { [[ -f "${PRESET_DIR}/${1}.json" ]]; }

ee_running() { pgrep -x easyeffects >/dev/null 2>&1; }

ee_ensure_service() {
    ee_running && return 0

    # Try systemd user service first
    if systemctl --user start easyeffects 2>/dev/null; then
        sleep 0.8
        return 0
    fi

    # Fallback: detach from terminal completely (survives terminal close)
    setsid easyeffects --service-mode >/dev/null 2>&1 &
    disown $!
    sleep 1
}

ee_apply() {
    local preset="$1"
    ee_ensure_service
    easyeffects --bypass 2 &>/dev/null
    sleep 0.2
    easyeffects --load-preset "$preset" &>/dev/null
}

save_state() {
    mkdir -p "$CONFIG_DIR"
    cat >"$STATE_FILE" <<EOF
SIGNATURE=${1:-}
DEVICE=${2:-}
MODE=${3:-}
APPLIED_PRESET=${4:-}
TIMESTAMP=$(date -Iseconds)
EOF
}

load_state() {
    [[ -f "$STATE_FILE" ]] && source "$STATE_FILE" 2>/dev/null || true
}

# ── Smart Apply: auto-detect device + merge ───────────────────────────────────
smart_apply() {
    local preset="$1"
    local context="${2:-}"   # "signature" or "mode" — just for state saving

    preset_exists "$preset" || die "Preset '$preset' not found. Run: audiofx list"

    local applied_preset="$preset"
    local device="unknown"
    local device_label="unknown"

    # Use the smart engine if available
    if [[ -f "$SMART_SCRIPT" ]] && command -v python3 >/dev/null; then
        local result
        result=$(python3 "$SMART_SCRIPT" merge "$preset" 2>/dev/null || echo "${preset}|unknown|unknown")
        applied_preset=$(echo "$result" | cut -d'|' -f1)
        device=$(echo "$result" | cut -d'|' -f2)
        device_label=$(echo "$result" | cut -d'|' -f3)
    fi

    ee_apply "$applied_preset"

    # Save state
    if [[ "$context" == "mode" ]]; then
        save_state "" "$device" "$preset" "$applied_preset"
    else
        save_state "$preset" "$device" "" "$applied_preset"
    fi

    # Show what happened
    echo -e "${GREEN}✓${RESET} ${BOLD}${preset}${RESET}"
    tip "Device: ${CYAN}${device_label}${RESET}"
    if [[ "$applied_preset" != "$preset" ]]; then
        tip "Auto-merged device compensation into preset"
    fi
}

# ── Commands ──────────────────────────────────────────────────────────────────

cmd_list() {
    echo ""
    echo -e " ${BOLD}omarchy-audio-fx${RESET} ${DIM}v${VERSION}${RESET}"
    echo -e " ${DIM}Device compensation applied automatically — just pick your sound.${RESET}"
    echo ""

    echo -e " ${BOLD}🎵 Sound Signatures${RESET}"
    for name in "${SIGNATURES[@]}"; do
        local color="${SIG_COLOR[$name]:-${RESET}}"
        local desc="${SIG_DESC[$name]:-}"
        local exists="${DIM}✗${RESET}"; preset_exists "$name" && exists="${GREEN}✓${RESET}"
        printf "  %b %b%-20s${RESET}  ${DIM}%s${RESET}\n" "$exists" "$color" "$name" "$desc"
    done

    echo ""
    echo -e " ${BOLD}🌍 Experience Modes${RESET}"
    for name in "${MODES[@]}"; do
        local desc="${MODE_DESC[$name]:-}"
        local exists="${DIM}✗${RESET}"; preset_exists "$name" && exists="${GREEN}✓${RESET}"
        printf "  %b %-20s  ${DIM}%s${RESET}\n" "$exists" "$name" "$desc"
    done

    echo ""

    # Show detected device
    if [[ -f "$SMART_SCRIPT" ]] && command -v python3 >/dev/null; then
        local info
        info=$(python3 "$SMART_SCRIPT" info 2>/dev/null || echo "{}")
        local det_device det_label
        det_device=$(echo "$info" | python3 -c "import json,sys; d=json.load(sys.stdin); print(d.get('detected_device','?'))" 2>/dev/null || echo "?")
        det_label=$(echo "$info" | python3 -c "import json,sys; d=json.load(sys.stdin); print(d.get('label','?'))" 2>/dev/null || echo "?")
        echo -e " ${BOLD}🎧 Detected Device${RESET}"
        echo -e "  ${CYAN}${det_label}${RESET}"
        echo ""
    fi

    echo -e " ${DIM}audiofx set <name>  |  audiofx mode <mode>  |  audiofx off${RESET}"
    echo ""
}

cmd_status() {
    load_state
    echo ""
    echo -e " ${BOLD}Current Audio State${RESET}"
    echo -e "  Signature     : ${ORANGE}${SIGNATURE:-none}${RESET}"
    echo -e "  Experience    : ${PURPLE}${MODE:-none}${RESET}"
    echo -e "  Auto-device   : ${CYAN}${DEVICE:-detecting...}${RESET}"
    echo -e "  Active preset : ${GREEN}${APPLIED_PRESET:-none}${RESET}"
    echo -e "  Set at        : ${DIM}${TIMESTAMP:-unknown}${RESET}"
    echo ""

    # Live device detection
    if [[ -f "$SMART_SCRIPT" ]] && command -v python3 >/dev/null; then
        local det
        det=$(python3 "$SMART_SCRIPT" detect 2>/dev/null || echo "unknown")
        echo -e "  Now detected  : ${CYAN}${det}${RESET}"
    fi
    echo ""
}

cmd_set() {
    local name="${1:-}"
    [[ -z "$name" ]] && die "Usage: audiofx set <SignatureName>"
    echo -e " Applying ${BOLD}${name}${RESET}..."
    smart_apply "$name" "signature"
    tip "${SIG_DESC[$name]:-}"
}

cmd_mode() {
    local name="${1:-}"
    [[ -z "$name" ]] && die "Usage: audiofx mode <ModeName>"
    echo -e " Applying mode ${BOLD}${name}${RESET}..."
    smart_apply "$name" "mode"
    tip "${MODE_DESC[$name]:-}"
}

cmd_off() {
    easyeffects --bypass 1
    save_state "" "" "" "off"
    info "All audio effects bypassed"
}

cmd_device() {
    if [[ -f "$SMART_SCRIPT" ]] && command -v python3 >/dev/null; then
        local raw
        raw=$(python3 "$SMART_SCRIPT" info 2>/dev/null) || { die "audiofx-smart not installed. Run install.sh"; return; }

        local dev_name det_device label comp override
        dev_name=$(echo "$raw" | python3 -c "import json,sys; d=json.load(sys.stdin); print(d.get('device_name','?'))" 2>/dev/null)
        det_device=$(echo "$raw" | python3 -c "import json,sys; d=json.load(sys.stdin); print(d.get('detected_device','?'))" 2>/dev/null)
        label=$(echo "$raw" | python3 -c "import json,sys; d=json.load(sys.stdin); print(d.get('label','?'))" 2>/dev/null)
        comp=$(echo "$raw" | python3 -c "import json,sys; d=json.load(sys.stdin); c=d.get('compensation',[]); print(', '.join(p.split('#')[0] for p in c) if c else 'none')" 2>/dev/null)
        override=$(echo "$raw" | python3 -c "import json,sys; d=json.load(sys.stdin); print('yes' if d.get('override') else 'no')" 2>/dev/null)

        echo ""
        echo -e " ${BOLD}🎧 Active Device${RESET}"
        echo -e "   ${CYAN}${dev_name}${RESET}"
        echo ""
        echo -e "   Type         : ${ORANGE}${det_device}${RESET}$(  [[ "$override" == "yes" ]] && echo -e "  ${YELLOW}(manually set)${RESET}" )"
        echo -e "   Tuning       : ${GREEN}${label}${RESET}"
        echo -e "   Auto-adds    : ${DIM}${comp}${RESET}"
        echo ""
        echo -e " ${BOLD}Change detection:${RESET}"
        echo -e "   ${CYAN}audiofx device set headphones${RESET}        → force headphone tuning"
        echo -e "   ${CYAN}audiofx device set earbuds${RESET}           → force earbud tuning"
        echo -e "   ${CYAN}audiofx device set iem${RESET}               → force IEM tuning"
        echo -e "   ${CYAN}audiofx device set laptop-speakers${RESET}   → force laptop speaker tuning"
        echo -e "   ${CYAN}audiofx device set desktop-speakers${RESET}  → force desktop speaker tuning"
        echo -e "   ${CYAN}audiofx device set bluetooth-speaker${RESET} → force BT speaker tuning"
        echo -e "   ${CYAN}audiofx device reset${RESET}                 → back to auto-detection"
        echo ""
    else
        die "audiofx-smart not installed. Run install.sh"
    fi
}

cmd_device_set() {
    local dtype="${1:-}"
    local valid=("headphones" "iem" "earbuds" "laptop-speakers" "desktop-speakers")
    local ok=0
    for v in "${valid[@]}"; do [[ "$v" == "$dtype" ]] && ok=1; done

    if [[ $ok -eq 0 ]]; then
        echo -e " ${RED}✗${RESET} Unknown device type: ${dtype}"
        echo ""
        echo -e " Valid options:"
        echo -e "   ${CYAN}headphones${RESET}       — over-ear wired headphones (adds crossfeed)"
        echo -e "   ${CYAN}iem${RESET}              — wired in-ear monitors (resonance fix)"
        echo -e "   ${CYAN}earbuds${RESET}          — TWS/Bluetooth earbuds (bass virtualization)"
        echo -e "   ${CYAN}laptop-speakers${RESET}  — laptop built-in speakers (bass + widening)"
        echo -e "   ${CYAN}desktop-speakers${RESET} — bookshelf/BT speakers (reference)"
        echo ""
        exit 1
    fi

    python3 "$SMART_SCRIPT" set-override "$dtype" >/dev/null
    info "Device override set to: ${CYAN}${dtype}${RESET}"
    tip "Re-apply your preset to hear the change: audiofx set Marshall"
    echo ""
}

cmd_device_reset() {
    python3 "$SMART_SCRIPT" clear-override >/dev/null 2>&1 || true
    info "Device override cleared — back to auto-detection"
    local detected
    detected=$(python3 "$SMART_SCRIPT" detect 2>/dev/null || echo "unknown")
    tip "Auto-detected: ${CYAN}${detected}${RESET}"
    echo ""
}


cmd_help() {
    echo ""
    echo -e " ${BOLD}audiofx${RESET} ${DIM}v${VERSION}${RESET}  —  Smart Audio Mode Switcher"
    echo -e " ${DIM}Auto-detects your device. Just pick the sound you want.${RESET}"
    echo ""
    echo -e " ${BOLD}USAGE${RESET}"
    echo -e "   audiofx ${CYAN}list${RESET}           Show all signatures + modes"
    echo -e "   audiofx ${CYAN}status${RESET}         Show current state + detected device"
    echo -e "   audiofx ${CYAN}device${RESET}         Show detected device details"
    echo -e "   audiofx ${CYAN}set${RESET} <Name>     Apply a sound signature (device auto-tuned)"
    echo -e "   audiofx ${CYAN}mode${RESET} <Name>    Apply an experience mode (device auto-tuned)"
    echo -e "   audiofx ${CYAN}off${RESET}            Bypass all effects"
    echo ""
    echo -e " ${BOLD}EXAMPLES${RESET}"
    echo -e "   audiofx set Marshall       → warm bass (headphone crossfeed auto-added)"
    echo -e "   audiofx set Dolby-Atmos    → spatial + wide (bass boost if earbuds)"
    echo -e "   audiofx mode Cinema        → cinematic (auto-tuned for your device)"
    echo -e "   audiofx mode Gaming        → positional audio"
    echo ""
    echo -e " ${BOLD}SIGNATURES${RESET}"
    echo -e "   Marshall · Dolby-Atmos · Harman · Sony-Clear · Bose-Comfort"
    echo -e "   JBL-Loud · Sennheiser-Detail · Bass-Beast · Vocal-Clarity"
    echo -e "   Lo-Fi · Crystal-Air · Night-Mode"
    echo ""
    echo -e " ${BOLD}MODES${RESET}"
    echo -e "   Cinema · Gaming · Party · Focus"
    echo ""
}

# ── Entry Point ───────────────────────────────────────────────────────────────
cmd="${1:-help}"
shift || true

case "$cmd" in
    list|ls)         cmd_list ;;
    status|st)       cmd_status ;;
    device|dev)
        subcmd="${1:-}"; shift || true
        case "$subcmd" in
            set)   cmd_device_set "$@" ;;
            reset) cmd_device_reset ;;
            "")    cmd_device ;;
            *)     die "Unknown: audiofx device ${subcmd}. Try: set <type> | reset" ;;
        esac
        ;;
    set|s)           cmd_set "$@" ;;
    mode|m)          cmd_mode "$@" ;;
    off|bypass)      cmd_off ;;
    version|-v)      echo "audiofx v${VERSION}" ;;
    help|-h|--help)  cmd_help ;;
    *)
        # Try as a direct preset name
        if preset_exists "$cmd"; then
            smart_apply "$cmd"
        else
            die "Unknown command '$cmd'. Run: audiofx help"
        fi
        ;;
esac

