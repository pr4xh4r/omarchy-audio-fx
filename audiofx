# ── Helpers ───────────────────────────────────────────────────────────────────
def strip_ansi(s):
    return re.sub(r'\033\[[^m]*m', '', s)

def load_state():
    try:
        with open(STATE_FILE) as f:
            return json.load(f)
    except Exception:
        return {"device": 0, "mode": 0}

def save_state(device_id, mode_id):
    os.makedirs(os.path.dirname(STATE_FILE), exist_ok=True)
    with open(STATE_FILE, "w") as f:
        json.dump({"device": device_id, "mode": mode_id}, f)

def apply_audio(device_preset, mode_preset):
    if not device_preset and not mode_preset:
        subprocess.run(["easyeffects", "--bypass", "1"], capture_output=True)
    else:
        subprocess.run(
            ["python3", APPLY_SCRIPT,
             device_preset if device_preset else '""',
             mode_preset   if mode_preset   else '""'],
            capture_output=True
        )

def term_size():
    try:
        s = os.get_terminal_size()
        return s.columns, s.lines
    except Exception:
        return 80, 24

def clear():   sys.stdout.write("\033[2J\033[H"); sys.stdout.flush()
def hide_cur():sys.stdout.write("\033[?25l");     sys.stdout.flush()
def show_cur():sys.stdout.write("\033[?25h");     sys.stdout.flush()

def getch():
    fd = sys.stdin.fileno()
    old = termios.tcgetattr(fd)
    try:
        tty.setraw(fd)
        ch = sys.stdin.buffer.read(1)
        if ch == b'\x1b':
            ch2 = sys.stdin.buffer.read(1)
            if ch2 == b'[':
                ch3 = sys.stdin.buffer.read(1)
                return b'\x1b[' + ch3
            return b'\x1b'
        return ch
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, old)

# ── Drawing ───────────────────────────────────────────────────────────────────
def draw(w, device_id, mode_id, section, dev_cur, mode_cur):
    lines = []
    sep   = f"{DGRAY}{'─' * w}{R}"
    thin  = f"{DGRAY}{'╌' * (w - 4)}{R}"

    # Header
    title = f"{PURPLE}{BLD}◈  AUDIO FX{R}  {GRAY}Omarchy Sound Studio{R}"
    tpad  = (w - len(strip_ansi(title))) // 2
    lines += [sep, " " * tpad + title, sep]

    # Status bar
    dev = DEVICES[device_id]; mod = MODES[mode_id]
    d_s = f"{dev['color']}{dev['icon']} {dev['label']}{R}"
    m_s = f"{mod['color']}{mod['icon']} {mod['label']}{R}" if mod['id'] != 0 else f"{GRAY}Off{R}"
    status = f"  {GRAY}Device:{R} {d_s}   {GRAY}Mode:{R} {m_s}"
    lines += [status, sep]

    # ── Section builder
    def section_items(header, items, cur, active_id, sec_name):
        lines.append(f"\n  {GRAY}{BLD}{header}{R}")
        lines.append(f"  {DGRAY}{'╌' * (w - 4)}{R}")
        for item in items:
            is_sel    = (section == sec_name and item["id"] == cur)
            is_active = (item["id"] == active_id)
            c         = item["color"]

            if is_active:
                bullet = f"{c}▶{R}"
                label  = f"{c}{BLD}{item['label']:<14}{R}"
                desc   = f"{c}{DIM}{item['desc']}{R}"
                badge  = f" {c}●{R}"
            else:
                bullet = f"{DGRAY}·{R}"
                label  = f"{''+WHITE if is_sel else GRAY}{item['label']:<14}{R}"
                desc   = f"{DGRAY}{item['desc']}{R}"
                badge  = ""

            icon = f"{c}{item['icon']}{R}"
            row  = f"  {bg(30,30,50) if is_sel else ''} {bullet} {icon} {label}  {desc}{badge}{R}"
            rpad = " " * max(0, w - len(strip_ansi(row)))
            lines.append(row + rpad)

    section_items("OUTPUT DEVICE", DEVICES, dev_cur,  device_id, "device")
    section_items("SOUND MODE",    MODES,   mode_cur, mode_id,   "mode")

    # Footer
    lines.append(f"\n{sep}")
    if section == "device":
        hint = f"  {GRAY}↑↓ move  ·  Enter select device  ·  Tab → Sound Mode  ·  O off  ·  Q quit{R}"
    else:
        hint = f"  {GRAY}↑↓ move  ·  Enter select mode   ·  Tab → Device      ·  O off  ·  Q quit{R}"
    lines.append(hint)

    sys.stdout.write("\033[H")  # move to top without clearing (flicker-free)
    sys.stdout.write("\n".join(lines) + "\n")
    sys.stdout.flush()

# ── TUI loop ──────────────────────────────────────────────────────────────────
def run_tui():
    state    = load_state()
    device   = state["device"]
    mode     = state["mode"]
    section  = "mode"
    dev_cur  = device
    mode_cur = mode

    hide_cur()
    clear()
    try:
        while True:
            w, _ = term_size()
            draw(w, device, mode, section, dev_cur, mode_cur)

            key = getch()

            if key in (b'q', b'Q', b'\x03'):
                break

            elif key == b'\x1b[A':  # Up
                if section == "device":
                    dev_cur  = (dev_cur - 1) % len(DEVICES)
                else:
                    mode_cur = (mode_cur - 1) % len(MODES)

            elif key == b'\x1b[B':  # Down
                if section == "device":
                    dev_cur  = (dev_cur + 1) % len(DEVICES)
                else:
                    mode_cur = (mode_cur + 1) % len(MODES)

            elif key == b'\t':      # Tab
                section = "mode" if section == "device" else "device"

            elif key in (b'\r', b'\n', b' '):  # Enter / Space
                if section == "device":
                    device = dev_cur
                else:
                    mode = mode_cur
                save_state(device, mode)

                # Flash feedback
                w, _ = term_size()
                sys.stdout.write("\033[H")
                sep = f"{DGRAY}{'─' * w}{R}"
                sys.stdout.write(sep + "\n")
                msg = f"  {CYAN}{BLD}Applying…{R}  {DEVICES[device]['color']}{DEVICES[device]['icon']} {DEVICES[device]['label']}{R}  +  {MODES[mode]['color']}{MODES[mode]['icon']} {MODES[mode]['label']}{R}"
                sys.stdout.write(msg + "\n" + sep + "\n")
                sys.stdout.flush()

                apply_audio(DEVICES[device]["preset"], MODES[mode]["preset"])
                time.sleep(0.35)

            elif key in (b'o', b'O'):   # Off
                mode = 0; mode_cur = 0
                save_state(device, 0)
                apply_audio(DEVICES[device]["preset"], "")

    finally:
        show_cur()
        clear()
        dev = DEVICES[device]; mod = MODES[mode]
        print(f"\n  {PURPLE}{BLD}AudioFX{R}  {GRAY}effects running in background{R}")
        print(f"  {GRAY}Device :{R} {dev['color']}{dev['icon']} {dev['label']}{R}")
        print(f"  {GRAY}Mode   :{R} {(mod['color']+mod['icon']+' '+mod['label']+R) if mod['id'] else GRAY+'Off'+R}")
        print(f"\n  {DGRAY}Run {WHITE}audiofx{DGRAY} again to change  ·  {WHITE}audiofx --off{DGRAY} to disable{R}\n")

# ── CLI flags ─────────────────────────────────────────────────────────────────
def cmd_status():
    state = load_state()
    dev = DEVICES[state["device"]]; mod = MODES[state["mode"]]
    print(f"\n  {PURPLE}{BLD}AudioFX Status{R}")
    print(f"  {GRAY}Device :{R} {dev['color']}{dev['icon']} {dev['label']}{R}  {DGRAY}{dev['desc']}{R}")
    print(f"  {GRAY}Mode   :{R} {(mod['color']+mod['icon']+' '+mod['label']+R+'  '+DGRAY+mod['desc']+R) if mod['id'] else GRAY+'Off — no effects'+R}")
    print()

def cmd_off():
    state = load_state()
    save_state(state["device"], 0)
    subprocess.run(["easyeffects", "--bypass", "1"], capture_output=True)
    print(f"\n  {GREEN}✓{R}  All effects turned off\n")

# ── Entry ─────────────────────────────────────────────────────────────────────
if __name__ == "__main__":
    args = sys.argv[1:]
    if "--status" in args: cmd_status()
    elif "--off"  in args: cmd_off()
    else:                  run_tui()
