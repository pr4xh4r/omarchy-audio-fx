#!/usr/bin/env python3
"""afx — Omarchy Audio FX  (type 'afx' to launch)"""

import curses, json, os, subprocess, sys, time

# ── Paths ─────────────────────────────────────────────────────────────────────
PLUGIN_DIR   = os.path.expanduser("~/.config/omarchy/plugins/pr4xh4r.audio")
APPLY_SCRIPT = os.path.join(PLUGIN_DIR, "apply-audio.py")
STATE_FILE   = os.path.expanduser("~/.local/share/afx/state.json")

# ── Catalogs  (label, description, preset_name, color_slot) ──────────────────
# color_slot: 0=gray  1=purple  2=blue  3=cyan  4=green  5=yellow  6=orange  7=pink
DEVICES = [
    ("Auto",             "No device compensation",    "",                  0),
    ("Headphones",       "Over-ear headphones",       "Headphones",        6),
    ("Earbuds",          "In-ear earbuds",            "Earbuds",           7),
    ("IEM",              "Studio in-ear monitors",    "IEM",               1),
    ("BT Speaker",       "Bluetooth speaker",         "Bluetooth-Speaker", 2),
    ("Desktop Speakers", "Desktop monitor speakers",  "Desktop-Speakers",  4),
    ("Laptop Speakers",  "Built-in laptop speakers",  "Laptop-Speakers",   5),
]

MODES = [
    ("Off",           "No effects - pure device sound", "",              0),
    ("Marshall",      "Warm bass · Punchy mids",        "Marshall",      6),
    ("Dolby Atmos",   "Wide · Immersive · Spatial",     "Dolby-Atmos",   2),
    ("Gaming",        "Spatial cues · Wide stereo",     "Gaming",        4),
    ("Bass Boost",    "Heavy sub-bass · EDM",           "Bass-Boost",    7),
    ("Bass Beast",    "Extreme bass · Max impact",      "Bass-Beast",    7),
    ("Vocal",         "Clear mids · Presence · Calls",  "Vocal",         1),
    ("Vocal Clarity", "Enhanced speech · Crystal clear","Vocal-Clarity", 1),
    ("Night Mode",    "Compressed · No loud spikes",    "Night-Mode",    0),
    ("Classical",     "Neutral · Audiophile · Hall",    "Classical",     5),
    ("Rock",          "V-shape · Punchy · Sizzling",    "Rock",          7),
    ("JBL Loud",      "Booming bass · Max loudness",    "JBL-Loud",      6),
    ("Sennheiser",    "Warm · Forward mids · Smooth",   "Sennheiser",    3),
    ("Sony",          "Powerful bass · Wide · Crisp",   "Sony",          2),
    ("Bose Comfort",  "Smooth · Rich · Relaxed",        "Bose-Comfort",  1),
    ("Harman",        "Research-tuned reference",       "Harman",        5),
    ("Cinema",        "Surround · Movie · Cinematic",   "Cinema",        6),
    ("Party",         "Loud · Energetic · Max fun",     "Party",         7),
    ("Lo-Fi",         "Vintage · Warm · Nostalgic",     "Lo-Fi",         6),
    ("Crystal Air",   "Airy · Open · Ultra-transparent","Crystal-Air",   3),
    ("Focus",         "Flat · Clean · No distraction",  "Focus",         4),
]

# ── Flat navigation list ──────────────────────────────────────────────────────
def build_nav():
    nav = [("device", i) for i in range(len(DEVICES))]
    nav += [("mode",  i) for i in range(len(MODES))]
    return nav

# ── State ─────────────────────────────────────────────────────────────────────
def load_state():
    try:
        with open(STATE_FILE) as f:
            return json.load(f)
    except Exception:
        return {"device": 0, "mode": 0}

def save_state(device, mode):
    os.makedirs(os.path.dirname(STATE_FILE), exist_ok=True)
    with open(STATE_FILE, "w") as f:
        json.dump({"device": device, "mode": mode}, f)

# ── Audio ─────────────────────────────────────────────────────────────────────
def apply_audio(dev_preset, mode_preset):
    """Fire-and-forget — returns instantly, audio loads in background."""
    if not dev_preset and not mode_preset:
        subprocess.Popen(["easyeffects", "--bypass", "1"],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    else:
        subprocess.Popen(
            ["python3", APPLY_SCRIPT,
             dev_preset  if dev_preset  else '""',
             mode_preset if mode_preset else '""'],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL
        )

# ── Colors ────────────────────────────────────────────────────────────────────
# Pair numbers: 1-8 for slots 0-7, 9=header-purple, 10=cursor-row
def setup_colors():
    curses.start_color()
    curses.use_default_colors()
    can256 = curses.COLORS >= 256

    slot_to_256 = {0: 245, 1: 135, 2: 69, 3: 87, 4: 71, 5: 220, 6: 208, 7: 205}
    slot_to_basic = {
        0: curses.COLOR_WHITE,   1: curses.COLOR_MAGENTA,
        2: curses.COLOR_BLUE,    3: curses.COLOR_CYAN,
        4: curses.COLOR_GREEN,   5: curses.COLOR_YELLOW,
        6: curses.COLOR_RED,     7: curses.COLOR_MAGENTA,
    }

    for slot in range(8):
        fg = slot_to_256[slot] if can256 else slot_to_basic[slot]
        curses.init_pair(slot + 1, fg, -1)

    # Pair 9: purple for "afx" title
    curses.init_pair(9, 135 if can256 else curses.COLOR_MAGENTA, -1)
    # Pair 10: cursor highlight row
    curses.init_pair(10, curses.COLOR_WHITE, 237 if can256 else curses.COLOR_BLUE)

def cp(slot):
    """Color pair attr for a catalog color slot."""
    return curses.color_pair(slot + 1)

# ── Safe addstr ───────────────────────────────────────────────────────────────
def put(win, y, x, text, attr=0):
    h, w = win.getmaxyx()
    if y < 0 or y >= h or x < 0 or x >= w:
        return
    text = text[:max(0, w - x - 1)]
    if not text:
        return
    try:
        win.addstr(y, x, text, attr)
    except curses.error:
        pass

# ── Draw ──────────────────────────────────────────────────────────────────────
HEADER_H = 5
FOOTER_H = 2

def draw(stdscr, nav, cur, device, mode, status, vp_top):
    h, w = stdscr.getmaxyx()
    stdscr.erase()

    avail = max(1, h - HEADER_H - FOOTER_H)
    gray  = cp(0) | curses.A_DIM
    dim   = cp(0) | curses.A_DIM

    # ── Header ────────────────────────────────────────────────────
    stdscr.hline(0, 0, curses.ACS_HLINE, w)
    put(stdscr, 1, 2, "afx", curses.color_pair(9) | curses.A_BOLD)
    put(stdscr, 1, 6, "  Omarchy Sound Studio", cp(0))
    stdscr.hline(2, 0, curses.ACS_HLINE, w)

    # Status line
    dev_l, _, _, dev_c = DEVICES[device]
    mod_l, _, _, mod_c = MODES[mode]
    if status:
        put(stdscr, 3, 2, status, cp(3) | curses.A_BOLD)
    else:
        put(stdscr, 3, 2, "Device: ", cp(0))
        put(stdscr, 3, 10, dev_l, cp(dev_c) | curses.A_BOLD)
        x2 = 10 + len(dev_l) + 3
        put(stdscr, 3, x2, "Mode: ", cp(0))
        put(stdscr, 3, x2 + 6, mod_l, cp(mod_c) | curses.A_BOLD)
    stdscr.hline(4, 0, curses.ACS_HLINE, w)

    # ── Build item list ───────────────────────────────────────────
    # Each entry: (nav_idx_or_-1, kind, data)
    #   kind: "header" -> data=title  |  "device"/"mode" -> data=catalog_idx
    items = []
    items.append((-1, "header", "OUTPUT DEVICE"))
    for ni, (sec, idx) in enumerate(nav):
        if sec == "device":
            items.append((ni, "device", idx))
    items.append((-1, "gap", None))
    items.append((-1, "header", "SOUND MODE"))
    for ni, (sec, idx) in enumerate(nav):
        if sec == "mode":
            items.append((ni, "mode", idx))

    # Auto-scroll viewport so cursor stays visible
    cur_line = next((i for i, (ni, _, _) in enumerate(items) if ni == cur), 0)
    if cur_line < vp_top:
        vp_top = cur_line
    elif cur_line >= vp_top + avail:
        vp_top = cur_line - avail + 1
    vp_top = max(0, min(vp_top, max(0, len(items) - avail)))

    visible = items[vp_top: vp_top + avail]

    # ── Draw items ────────────────────────────────────────────────
    LABEL_W = 18
    for i, (ni, kind, data) in enumerate(visible):
        y = HEADER_H + i
        if y >= h - FOOTER_H:
            break

        if kind == "header":
            put(stdscr, y, 2, data, cp(0) | curses.A_BOLD)
            continue

        if kind == "gap":
            continue

        catalog    = DEVICES if kind == "device" else MODES
        label, desc, preset, color_slot = catalog[data]
        is_active  = (data == device) if kind == "device" else (data == mode)
        is_cursor  = (ni == cur)
        item_attr  = cp(color_slot)
        label_pad  = label[:LABEL_W].ljust(LABEL_W)

        if is_cursor:
            # Highlight entire row
            try:
                stdscr.addstr(y, 2, " " * (w - 3), curses.color_pair(10))
            except curses.error:
                pass
            put(stdscr, y, 3, ">", item_attr | curses.A_BOLD)
            put(stdscr, y, 5, label_pad, curses.color_pair(10) | curses.A_BOLD)
            put(stdscr, y, 5 + LABEL_W + 1, desc, curses.color_pair(10))
            if is_active:
                put(stdscr, y, 5 + LABEL_W + 2 + len(desc), "*", item_attr | curses.A_BOLD)
        elif is_active:
            put(stdscr, y, 3, ">", item_attr | curses.A_BOLD)
            put(stdscr, y, 5, label_pad, item_attr | curses.A_BOLD)
            put(stdscr, y, 5 + LABEL_W + 1, desc, cp(0))
            put(stdscr, y, 5 + LABEL_W + 2 + len(desc), "*", item_attr)
        else:
            put(stdscr, y, 3, ".", dim)
            put(stdscr, y, 5, label_pad, cp(0))
            put(stdscr, y, 5 + LABEL_W + 1, desc, dim)

    # ── Footer ────────────────────────────────────────────────────
    fy = h - 2
    stdscr.hline(fy, 0, curses.ACS_HLINE, w)
    put(stdscr, h - 1, 2,
        "up/down: navigate    enter: apply    o: off    q: quit",
        cp(0) | curses.A_DIM)

    stdscr.refresh()
    return vp_top

# ── TUI ───────────────────────────────────────────────────────────────────────
def run_tui():
    def _main(stdscr):
        setup_colors()
        curses.curs_set(0)
        stdscr.keypad(True)
        curses.mousemask(curses.ALL_MOUSE_EVENTS | curses.REPORT_MOUSE_POSITION)

        state  = load_state()
        device = state.get("device", 0)
        mode   = state.get("mode", 0)
        nav    = build_nav()
        cur    = 0
        vp_top = 0
        status = ""

        # Start cursor on current mode
        for i, (sec, idx) in enumerate(nav):
            if sec == "mode" and idx == mode:
                cur = i
                break

        while True:
            vp_top = draw(stdscr, nav, cur, device, mode, status, vp_top)
            status = ""

            key = stdscr.getch()

            if key in (ord('q'), ord('Q'), 27):   # q / Q / Esc
                break

            elif key == curses.KEY_UP:
                cur = (cur - 1) % len(nav)

            elif key == curses.KEY_DOWN:
                cur = (cur + 1) % len(nav)

            elif key in (10, 13, ord(' ')):        # Enter / Space
                sec, idx = nav[cur]
                if sec == "device":
                    device = idx
                else:
                    mode = idx
                save_state(device, mode)
                label = DEVICES[idx][0] if sec == "device" else MODES[idx][0]
                status = f"Applying {label}..."
                draw(stdscr, nav, cur, device, mode, status, vp_top)
                apply_audio(DEVICES[device][2], MODES[mode][2])
                status = "Done"

            elif key in (ord('o'), ord('O')):      # O — turn off
                mode = 0
                save_state(device, 0)
                status = "Effects off"
                apply_audio(DEVICES[device][2], "")

            elif key == curses.KEY_MOUSE:
                try:
                    _, _, _, _, bstate = curses.getmouse()
                    if bstate & curses.BUTTON4_PRESSED:   # scroll up
                        cur = (cur - 1) % len(nav)
                    elif bstate & curses.BUTTON5_PRESSED: # scroll down
                        cur = (cur + 1) % len(nav)
                except curses.error:
                    pass

            elif key == curses.KEY_RESIZE:
                stdscr.clear()

        return device, mode

    device, mode = curses.wrapper(_main)

    dev_l = DEVICES[device][0]
    mod_l = MODES[mode][0] if mode else "Off"
    print(f"\n  afx  effects running in background")
    print(f"  Device : {dev_l}")
    print(f"  Mode   : {mod_l}")
    print(f"\n  Type 'afx' to change  .  'afx --off' to disable\n")

# ── CLI flags ─────────────────────────────────────────────────────────────────
def cmd_status():
    s   = load_state()
    dev = DEVICES[s.get("device", 0)]
    mod = MODES[s.get("mode", 0)]
    print(f"\n  afx status")
    print(f"  Device : {dev[0]}  -  {dev[1]}")
    print(f"  Mode   : {mod[0]}  -  {mod[1]}" if s.get("mode") else "  Mode   : Off")
    print()

def cmd_off():
    s = load_state()
    save_state(s.get("device", 0), 0)
    subprocess.run(["easyeffects", "--bypass", "1"], capture_output=True)
    print("\n  OK  All effects turned off\n")

# ── Entry ─────────────────────────────────────────────────────────────────────
if __name__ == "__main__":
    args = sys.argv[1:]
    if   "--status" in args: cmd_status()
    elif "--off"    in args: cmd_off()
    else:                    run_tui()
