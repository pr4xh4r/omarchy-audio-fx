# ── Flat navigable list ───────────────────────────────────────────────────────
# Each entry is ("device", idx) or ("mode", idx) — headers are not in this list
def build_nav():
    """Returns list of (section, item_index) for all navigable rows."""
    rows = []
    rows += [("device", i) for i in range(len(DEVICES))]
    rows += [("mode",   i) for i in range(len(MODES))]
    return rows

# ── State ─────────────────────────────────────────────────────────────────────
def load_state():
    try:
        with open(STATE_FILE) as f: return json.load(f)
    except Exception:
        return {"device": 0, "mode": 0}

def save_state(device, mode):
    os.makedirs(os.path.dirname(STATE_FILE), exist_ok=True)
    with open(STATE_FILE, "w") as f:
        json.dump({"device": device, "mode": mode}, f)

# ── Audio ─────────────────────────────────────────────────────────────────────
def apply_audio(dev_preset, mode_preset):
    if not dev_preset and not mode_preset:
        subprocess.run(["easyeffects", "--bypass", "1"], capture_output=True)
    else:
        subprocess.run(
            ["python3", APPLY_SCRIPT,
             dev_preset  if dev_preset  else '""',
             mode_preset if mode_preset else '""'],
            capture_output=True
        )

# ── Terminal ──────────────────────────────────────────────────────────────────
def term_size():
    try:    s = os.get_terminal_size(); return s.columns, s.lines
    except: return 80, 24

def strip_ansi(s):
    return re.sub(r'\033\[[^a-zA-Z]*[a-zA-Z]', '', s)

def write_line(line, w):
    """Write a line padded/trimmed to exactly w columns then erase to EOL."""
    plain = strip_ansi(line)
    if len(plain) > w:
        # Trim visible content — crude but safe
        line = line[:w + (len(line) - len(plain))]
    pad = " " * max(0, w - len(strip_ansi(line)))
    sys.stdout.write(line + pad + "\033[K\n")

def getch(fd):
    """Read one keypress — raw, no echo, with escape-sequence detection."""
    ch = os.read(fd, 1)
    if ch == b'\x1b':
        ready, _, _ = select.select([fd], [], [], 0.05)
        if ready:
            ch2 = os.read(fd, 1)
            if ch2 == b'[':
                ready2, _, _ = select.select([fd], [], [], 0.05)
                if ready2:
                    ch3 = os.read(fd, 1)
                    return b'\x1b[' + ch3
            return b'\x1b' + ch2
        return b'\x1b'
    return ch

# ── Renderer ──────────────────────────────────────────────────────────────────
HEADER_LINES = 5   # sep + title + sep + status + sep
FOOTER_LINES = 2   # sep + hint

def render(w, h, nav, cur, device, mode, status, vp_top):
    """
    Render the full TUI.
    Uses cursor-home + line-by-line overwrite + erase-rest — no screen clear,
    no scrollback pollution, no flickering.
    """
    avail = h - HEADER_LINES - FOOTER_LINES   # rows available for items list

    dev = DEVICES[device]; mod = MODES[mode]
    sep  = DGRAY + "─" * w + R
    thin = DGRAY + "╌" * (w - 4) + R

    # Move cursor to top-left (no clear — we overwrite line by line)
    sys.stdout.write("\033[H")

    # ── Header (5 lines) ─────────────────────────────────────────
    write_line(sep, w)
    write_line(f"  {PURPLE}{BLD}afx{R}  {GRAY}Omarchy Sound Studio{R}", w)
    write_line(sep, w)
    if status:
        write_line(f"  {CYAN}{BLD}{status}{R}", w)
    else:
        d_s = f"{dev['color']}{dev['icon']} {dev['label']}{R}"
        m_s = (f"{mod['color']}{mod['icon']} {mod['label']}{R}") if mode else f"{GRAY}Off{R}"
        write_line(f"  {GRAY}Device:{R} {d_s}   {GRAY}Mode:{R} {m_s}", w)
    write_line(sep, w)

    # ── Build full item lines list ────────────────────────────────
    item_lines = []   # list of (rendered_line, nav_index_or_None)

    def section_header(title):
        item_lines.append((f"  {GRAY}{BLD}{title}{R}", None))
        item_lines.append((f"  {thin}", None))

    section_header("OUTPUT DEVICE")
    for ni, (sec, idx) in enumerate(nav):
        if sec != "device": break
        item  = DEVICES[idx]
        is_active  = (idx == device)
        is_cursor  = (ni == cur)
        c     = item["color"]
        label = f"{item['label']:<16}"
        desc  = item["desc"]
        icon  = item["icon"]

        if is_cursor and is_active:
            bg   = bgc(40,28,60)
            bul  = f"{c}>{R}"; lt = f"{c}{BLD}{label}{R}"; dt = f"{c}{DIM}{desc}{R}"; bd = f" {c}*{R}"
        elif is_active:
            bg   = ""
            bul  = f"{c}>{R}"; lt = f"{c}{BLD}{label}{R}"; dt = f"{c}{DIM}{desc}{R}"; bd = f" {c}*{R}"
        elif is_cursor:
            bg   = bgc(28,28,48)
            bul  = f"{WHITE}>{R}"; lt = f"{WHITE}{BLD}{label}{R}"; dt = f"{GRAY}{desc}{R}"; bd = ""
        else:
            bg   = ""
            bul  = f"{DGRAY}.{R}"; lt = f"{GRAY}{label}{R}"; dt = f"{DGRAY}{desc}{R}"; bd = ""

        line = f"  {bg} {bul} {c}{icon}{R} {lt} {dt}{bd}{R}"
        item_lines.append((line, ni))

    # Blank line between sections
    item_lines.append(("", None))

    dev_count = len(DEVICES)
    section_header("SOUND MODE")
    for ni, (sec, idx) in enumerate(nav):
        if sec != "mode": continue
        item  = MODES[idx]
        is_active  = (idx == mode)
        is_cursor  = (ni == cur)
        c     = item["color"]
        label = f"{item['label']:<16}"
        desc  = item["desc"]
        icon  = item["icon"]

        if is_cursor and is_active:
            bg   = bgc(40,28,60)
            bul  = f"{c}>{R}"; lt = f"{c}{BLD}{label}{R}"; dt = f"{c}{DIM}{desc}{R}"; bd = f" {c}*{R}"
        elif is_active:
            bg   = ""
            bul  = f"{c}>{R}"; lt = f"{c}{BLD}{label}{R}"; dt = f"{c}{DIM}{desc}{R}"; bd = f" {c}*{R}"
        elif is_cursor:
            bg   = bgc(28,28,48)
            bul  = f"{WHITE}>{R}"; lt = f"{WHITE}{BLD}{label}{R}"; dt = f"{GRAY}{desc}{R}"; bd = ""
        else:
            bg   = ""
            bul  = f"{DGRAY}.{R}"; lt = f"{GRAY}{label}{R}"; dt = f"{DGRAY}{desc}{R}"; bd = ""

        line = f"  {bg} {bul} {c}{icon}{R} {lt} {dt}{bd}{R}"
        item_lines.append((line, ni))

    # ── Viewport: auto-scroll so cursor is always visible ─────────
    total = len(item_lines)
    # find line index of cursor row
    cursor_line = next((i for i, (_, ni) in enumerate(item_lines) if ni == cur), 0)

    # Keep cursor in viewport
    if cursor_line < vp_top:
        vp_top = cursor_line
    elif cursor_line >= vp_top + avail:
        vp_top = cursor_line - avail + 1
    vp_top = max(0, min(vp_top, total - avail))

    visible = item_lines[vp_top: vp_top + avail]

    # ── Draw items ────────────────────────────────────────────────
    for line, _ in visible:
        write_line(line, w)

    # Fill any unused rows below items (prevents stale content)
    for _ in range(avail - len(visible)):
        write_line("", w)

    # ── Footer (2 lines) ─────────────────────────────────────────
    # Scroll indicator
    pct = int((vp_top / max(1, total - avail)) * 100) if total > avail else 100
    scroll_info = f" {DGRAY}{pct}%{R}" if total > avail else ""
    write_line(sep + scroll_info, w)
    write_line(f"  {GRAY}up/down navigate  .  Enter apply  .  O off  .  Q quit{R}", w)

    # Erase anything below (safety)
    sys.stdout.write("\033[J")
    sys.stdout.flush()

    return vp_top   # return adjusted viewport top

# ── TUI loop ─────────────────────────────────────────────────────────────────
def run_tui():
    state  = load_state()
    device = state.get("device", 0)
    mode   = state.get("mode", 0)

    nav    = build_nav()   # flat list of (section, idx)
    cur    = 0             # cursor index into nav
    vp_top = 0             # viewport scroll offset

    # Start cursor on current mode
    for i, (sec, idx) in enumerate(nav):
        if sec == "mode" and idx == mode:
            cur = i; break

    fd  = sys.stdin.fileno()
    old = termios.tcgetattr(fd)

    # Hide cursor + clear screen fully (once) + clear scrollback
    sys.stdout.write("\033[?25l\033[3J\033[2J\033[H")
    sys.stdout.flush()

    status = ""
    try:
        tty.setraw(fd)   # raw mode set ONCE — stays until finally

        while True:
            w, h = term_size()
            vp_top = render(w, h, nav, cur, device, mode, status, vp_top)
            status = ""

            key = getch(fd)

            if key in (b'q', b'Q', b'\x03'):
                break

            elif key == b'\x1b[A':   # Up arrow
                cur = (cur - 1) % len(nav)

            elif key == b'\x1b[B':   # Down arrow
                cur = (cur + 1) % len(nav)

            elif key in (b'\r', b'\n', b' '):   # Enter / Space — apply
                sec, idx = nav[cur]
                if sec == "device":
                    device = idx
                else:
                    mode = idx
                save_state(device, mode)
                label = DEVICES[idx]["label"] if sec == "device" else MODES[idx]["label"]
                status = f"Applying {label}..."
                w, h = term_size()
                render(w, h, nav, cur, device, mode, status, vp_top)
                apply_audio(DEVICES[device]["preset"], MODES[mode]["preset"])
                time.sleep(0.35)
                status = "Applied"

            elif key in (b'o', b'O'):   # O — off
                mode = 0
                save_state(device, 0)
                status = "Effects off"
                apply_audio(DEVICES[device]["preset"], "")

    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, old)
        sys.stdout.write("\033[?25h\033[2J\033[H")
        sys.stdout.flush()

        dev = DEVICES[device]; mod = MODES[mode]
        m_s = f"{mod['color']}{mod['icon']} {mod['label']}{R}" if mode else f"{GRAY}Off{R}"
        print(f"\n  {PURPLE}{BLD}afx{R}  {GRAY}effects running in background{R}")
        print(f"  {GRAY}Device:{R} {dev['color']}{dev['icon']} {dev['label']}{R}")
        print(f"  {GRAY}Mode:  {R} {m_s}")
        print(f"\n  {DGRAY}Type {WHITE}afx{DGRAY} to change  .  {WHITE}afx --off{DGRAY} to disable{R}\n")

# ── CLI flags ─────────────────────────────────────────────────────────────────
def cmd_status():
    s = load_state()
    dev = DEVICES[s.get("device", 0)]; mod = MODES[s.get("mode", 0)]
    m   = s.get("mode", 0)
    print(f"\n  {PURPLE}{BLD}afx status{R}")
    print(f"  {GRAY}Device:{R} {dev['color']}{dev['icon']} {dev['label']}{R}  {DGRAY}{dev['desc']}{R}")
    print(f"  {GRAY}Mode:  {R} " + (f"{mod['color']}{mod['icon']} {mod['label']}{R}  {DGRAY}{mod['desc']}{R}" if m else f"{GRAY}Off{R}"))
    print()

def cmd_off():
    s = load_state()
    save_state(s.get("device", 0), 0)
    subprocess.run(["easyeffects", "--bypass", "1"], capture_output=True)
    print(f"\n  {GREEN}OK{R}  All effects turned off\n")

# ── Entry ─────────────────────────────────────────────────────────────────────
if __name__ == "__main__":
    args = sys.argv[1:]
    if   "--status" in args: cmd_status()
    elif "--off"    in args: cmd_off()
    else:                    run_tui()
