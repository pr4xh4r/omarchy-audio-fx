# ── Flat navigable row list ───────────────────────────────────────────────────
# Each entry: ("header", text)  |  ("device", idx)  |  ("mode", idx)
def build_rows():
    rows = [("header", "OUTPUT DEVICE")]
    rows += [("device", i) for i in range(len(DEVICES))]
    rows += [("header", "SOUND MODE")]
    rows += [("mode", i) for i in range(len(MODES))]
    return rows

def nav_indices(rows):
    """Return indices into rows[] that are navigable (not headers)."""
    return [i for i, r in enumerate(rows) if r[0] != "header"]

# ── State ─────────────────────────────────────────────────────────────────────
def load_state():
    try:
        with open(STATE_FILE) as f:
            return json.load(f)
    except Exception:
        return {"device": 0, "mode": 0}

def save_state(device, mode):
    os.makedirs(os.path.dirname(STATE_FILE), exist_ok=True)
    with open(STATE_FILE, "w") as f:
        json.dump({"device": device, "mode": mode}, f)

# ── Audio control ─────────────────────────────────────────────────────────────
def apply_audio(dev_preset, mode_preset):
    if not dev_preset and not mode_preset:
        subprocess.run(["easyeffects", "--bypass", "1"], capture_output=True)
    else:
        subprocess.run(
            ["python3", APPLY_SCRIPT,
             dev_preset  if dev_preset  else '""',
             mode_preset if mode_preset else '""'],
            capture_output=True
        )

# ── Terminal helpers ──────────────────────────────────────────────────────────
def term_w():
    try:    return os.get_terminal_size().columns
    except: return 80

def strip_ansi(s):
    return re.sub(r'\033\[[^m]*m', '', s)

# Single-call raw keyread using os.read + select (no per-call setraw toggle)
def getch(fd):
    ch = os.read(fd, 1)
    if ch == b'\x1b':
        ready, _, _ = select.select([fd], [], [], 0.05)
        if ready:
            ch2 = os.read(fd, 1)
            if ch2 == b'[':
                ready2, _, _ = select.select([fd], [], [], 0.05)
                if ready2:
                    ch3 = os.read(fd, 1)
                    return b'\x1b[' + ch3
            return b'\x1b' + ch2
        return b'\x1b'
    return ch

# ── Renderer ──────────────────────────────────────────────────────────────────
def render(w, rows, navs, cur_nav, device, mode, status):
    buf  = []
    sep  = DGRAY + "─" * w + R
    thin = DGRAY + "╌" * (w - 4) + R

    # Header
    title = f"  {PURPLE}{BLD}afx{R}  {GRAY}Omarchy Sound Studio{R}"
    buf.append(sep)
    buf.append(title)
    buf.append(sep)

    # Status / current state
    dev = DEVICES[device]; mod = MODES[mode]
    if status:
        buf.append(f"  {CYAN}{BLD}{status}{R}")
    else:
        d_s = f"{dev['color']}{dev['icon']} {dev['label']}{R}"
        m_s = f"{mod['color']}{mod['icon']} {mod['label']}{R}" if mode else f"{GRAY}Off{R}"
        buf.append(f"  {GRAY}Device:{R} {d_s}   {GRAY}Mode:{R} {m_s}")
    buf.append(sep)

    cur_row_idx = navs[cur_nav]

    for row_idx, row in enumerate(rows):
        kind = row[0]

        if kind == "header":
            buf.append(f"\n  {GRAY}{BLD}{row[1]}{R}")
            buf.append(f"  {thin}")
            continue

        sec, item_idx   = row
        item            = DEVICES[item_idx] if sec == "device" else MODES[item_idx]
        is_active       = (item_idx == device) if sec == "device" else (item_idx == mode)
        is_cursor       = (row_idx == cur_row_idx)
        c               = item["color"]
        label           = f"{item['label']:<16}"
        desc            = item["desc"]
        icon            = item["icon"]

        if is_active and is_cursor:
            bullet = f"{c}>{R}"; ltext = f"{c}{BLD}{label}{R}"
            dtext  = f"{c}{DIM}{desc}{R}"; badge = f" {c}*{R}"
            bg     = bgc(40, 28, 60)
        elif is_active:
            bullet = f"{c}>{R}"; ltext = f"{c}{BLD}{label}{R}"
            dtext  = f"{c}{DIM}{desc}{R}"; badge = f" {c}*{R}"
            bg     = ""
        elif is_cursor:
            bullet = f"{WHITE}>{R}"; ltext = f"{WHITE}{BLD}{label}{R}"
            dtext  = f"{GRAY}{desc}{R}"; badge = ""
            bg     = bgc(28, 28, 48)
        else:
            bullet = f"{DGRAY}.{R}"; ltext = f"{GRAY}{label}{R}"
            dtext  = f"{DGRAY}{desc}{R}"; badge = ""
            bg     = ""

        line     = f"  {bg} {bullet} {c}{icon}{R} {ltext} {dtext}{badge}{R}"
        pad      = " " * max(0, w - len(strip_ansi(line)))
        buf.append(line + pad)

    buf.append(f"\n{sep}")
    buf.append(f"  {GRAY}up/down navigate  .  Enter apply  .  O off  .  Q quit{R}")

    # Single atomic write — no partial renders
    sys.stdout.write("\033[2J\033[H" + "\n".join(buf) + "\n")
    sys.stdout.flush()

# ── TUI ───────────────────────────────────────────────────────────────────────
def run_tui():
    state  = load_state()
    device = state.get("device", 0)
    mode   = state.get("mode", 0)

    rows   = build_rows()
    navs   = nav_indices(rows)

    # Start cursor on current mode row
    cur_nav = 0
    for ni, ri in enumerate(navs):
        r = rows[ri]
        if r[0] == "mode" and r[1] == mode:
            cur_nav = ni
            break

    fd  = sys.stdin.fileno()
    old = termios.tcgetattr(fd)

    sys.stdout.write("\033[?25l")   # hide cursor
    sys.stdout.flush()

    try:
        tty.setraw(fd)              # raw mode set ONCE here, not per keystroke
        status = ""

        while True:
            w = term_w()
            render(w, rows, navs, cur_nav, device, mode, status)
            status = ""

            key = getch(fd)

            if key in (b'q', b'Q', b'\x03'):
                break

            elif key == b'\x1b[A':          # Up
                cur_nav = (cur_nav - 1) % len(navs)

            elif key == b'\x1b[B':          # Down
                cur_nav = (cur_nav + 1) % len(navs)

            elif key in (b'\r', b'\n', b' '):  # Enter / Space
                sec, item_idx = rows[navs[cur_nav]]
                if sec == "device":
                    device = item_idx
                else:
                    mode = item_idx
                save_state(device, mode)
                status = f"Applying {DEVICES[device]['label']} + {MODES[mode]['label']}..."
                render(w, rows, navs, cur_nav, device, mode, status)
                apply_audio(DEVICES[device]["preset"], MODES[mode]["preset"])
                time.sleep(0.4)
                status = "Done"

            elif key in (b'o', b'O'):       # O — turn off mode
                mode = 0
                save_state(device, 0)
                status = "Effects off"
                apply_audio(DEVICES[device]["preset"], "")

    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, old)   # restore terminal
        sys.stdout.write("\033[?25h\033[2J\033[H")      # show cursor, clear
        sys.stdout.flush()

        dev = DEVICES[device]; mod = MODES[mode]
        print(f"\n  {PURPLE}{BLD}afx{R}  {GRAY}effects running in background{R}")
        print(f"  {GRAY}Device:{R} {dev['color']}{dev['icon']} {dev['label']}{R}")
        m_str = f"{mod['color']}{mod['icon']} {mod['label']}{R}" if mode else f"{GRAY}Off{R}"
        print(f"  {GRAY}Mode:  {R} {m_str}")
        print(f"\n  {DGRAY}Type {WHITE}afx{DGRAY} to change  .  {WHITE}afx --off{DGRAY} to disable{R}\n")

# ── CLI flags ─────────────────────────────────────────────────────────────────
def cmd_status():
    state = load_state()
    dev = DEVICES[state.get("device", 0)]
    mod = MODES[state.get("mode", 0)]
    print(f"\n  {PURPLE}{BLD}afx status{R}")
    print(f"  {GRAY}Device:{R} {dev['color']}{dev['icon']} {dev['label']}{R}  {DGRAY}{dev['desc']}{R}")
    if state.get("mode", 0) == 0:
        print(f"  {GRAY}Mode:  {R} {GRAY}Off -- no effects{R}")
    else:
        print(f"  {GRAY}Mode:  {R} {mod['color']}{mod['icon']} {mod['label']}{R}  {DGRAY}{mod['desc']}{R}")
    print()

def cmd_off():
    state = load_state()
    save_state(state.get("device", 0), 0)
    subprocess.run(["easyeffects", "--bypass", "1"], capture_output=True)
    print(f"\n  {GREEN}OK{R}  All effects turned off\n")

# ── Entry ─────────────────────────────────────────────────────────────────────
if __name__ == "__main__":
    args = sys.argv[1:]
    if   "--status" in args: cmd_status()
    elif "--off"    in args: cmd_off()
    else:                    run_tui()
