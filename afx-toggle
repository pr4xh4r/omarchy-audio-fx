#!/usr/bin/env bash
# afx-toggle — focus existing afx window or open a new one
# Bound to Super+M in Hyprland

TITLE="afx"

# Check if an afx window is already open
if hyprctl clients -j 2>/dev/null | python3 -c "
import json, sys
clients = json.load(sys.stdin)
exists = any(c.get('title') == '$TITLE' for c in clients)
sys.exit(0 if exists else 1)
"; then
    # Window exists — focus it
    hyprctl dispatch focuswindow "title:$TITLE"
else
    # No window — open one
    foot --title="$TITLE" \
         --override=window-size-columns=72 \
         --override=window-size-lines=40 \
         afx
fi
